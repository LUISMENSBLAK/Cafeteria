NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Requerido para la Fase 2 (Sistema de Demos Multi-Tenant)
# Debe ser la llave service_role para evitar RLS al crear tenants y usuarios.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Requerido para el envío de correos de bienvenida
RESEND_API_KEY=your_resend_api_key

# Requerido opcionalmente para los correos (default: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=your_production_base_url

# Correo transaccional verificado en Resend
RESEND_FROM_EMAIL=bienvenida@innovanetwork.es

# Stripe (solo servidor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_MONTHLY_RECURRING=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=

# Ciclo comercial
BILLING_GRACE_PERIOD_DAYS=3
CRON_SECRET=
